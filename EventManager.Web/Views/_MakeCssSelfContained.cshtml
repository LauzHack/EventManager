@* Integrate CSS into the page on the first load so it's self-contained (and still load it by default so the page doesn't wait for styling) *@
<link id="style-deleteme" rel="stylesheet" href="/style.css" />
<script>
    if (document.querySelector('style') === null) {
        (async function() {
            var response = await fetch(`/style.css`)
            var tag = document.createElement('style');
            tag.innerHTML = await response.text();
            document.head.appendChild(tag);
            var existing = document.querySelector('#style-deleteme');
            existing.remove();
        })();
    }
</script>