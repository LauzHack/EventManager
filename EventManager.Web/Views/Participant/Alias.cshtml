@model PageModel<object, Participant>

@{
    string Mask(string emailAddress)
    {
        string MaskPart(string part)
        {
            var limit = (int)(part.Length / 3);
            return part.Substring(0, limit) + new string('*', part.Length - limit);
        }

        return string.Join('@', emailAddress.Split('@').Select(MaskPart));
    }
}

<section>
    <p>
        A similar name is already in our system. Did you already register? <em>(full emails not shown for privacy)</em>
    </p>

    <ul>
        @foreach (var candidate in Model.User.PossibleAliasEmailAddresses)
        {
            <li>
                @Mask(candidate)
            </li>
        }
    </ul>

    <form action="/Participant/Alias/ChooseCandidate">
        <input x-label="If you recognize one of your email addresses in the list above, enter it here"
               name="emailAddress"
               required
               type="email" />
        <button>
            Submit
        </button>
    </form>
</section>

<section>
    <form action="/Participant/Alias/Continue">
        <button>
            No, that's not me
        </button>
    </form>
</section>