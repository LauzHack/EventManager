@model OperationResult.Projects
@{
    ViewData["Title"] = "Projects";
    Layout = "_BareLayout";

    string challengesSeparator = "|";
    while (Model.ChallengeSetters.Any(c => c.Name.Contains(challengesSeparator)))
    {
        challengesSeparator += "|";
    }

    await Html.RenderPartialAsync("~/Views/_MakeCssSelfContained.cshtml");
}

<main>
    @if (Model.Contents.Count == 0)
    {
        <p>There are no projects yet.</p>
    }
    else
    {
        <h1>@Model.EventTitle Projects</h1>

        if (Model.ChallengeSetters.Any(s => s.IsChallengeOptIn))
        {
            <select x-label="Challenge"
                    onchange="showProjects(this.value)">
                <option value="" selected="selected"><em>any</em></option>
                @foreach (var setter in Model.ChallengeSetters)
                {
                    @if (setter.IsChallengeOptIn)
                    {
                        <option>@setter.Name</option>
                    }
                }
            </select>
        }

        <section id="projects-container"
                 style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-around; max-width: 100%">
            @foreach (var project in Model.Contents)
            {
                var awardByChallenge = Model.ChallengeSetters.SelectMany(c => c.Awards.Where(a => a.ProjectId == project.Id).Select(a => (c, a)));
                <article style="width: 25em; margin: 2em"
                         data-challenges="@string.Join(challengesSeparator, project.Challenges)">
                    <header style="padding: 1em; margin-bottom: 1em">
                        <strong>@project.Title</strong>
                        @foreach (var (challengeSetter, award) in awardByChallenge)
                        {
                            @* nowrap means the entire award will be on a single line, which avoids confusion *@
                            <mark data-order="@award.Order"
                                  data-challenge="@challengeSetter.Name"
                                  data-challenge-order="@challengeSetter.Order"
                                  style="white-space: nowrap; margin: 0 0.25em">@challengeSetter.Name @award.Name</mark>
                        }
                    </header>
                    <img id="img-@project.ThumbnailId" style="display: none; max-height: 20vh; margin: auto" />
                    @* Integrate images as base64 URLs on first load so the page is self-contained *@
                    <script>
                        (function() {
                            var img = document.getElementById('img-@project.ThumbnailId');
                            if (img.style.display === 'none') {
                                (async function() {
                                    var response = await fetch('/File/@(project.ThumbnailId)');
                                    var buffer = await response.arrayBuffer();
                                    var base64 = await new Promise(r => {
                                        var reader = new FileReader();
                                        reader.onload = () => r(reader.result);
                                        reader.readAsDataURL(new Blob([buffer]));
                                    });
                                    img.src = base64.replace('application/octet-stream', response.headers.get('Content-Type'));
                                    img.style.display = 'block';
                                })();
                            }
                        })();
                    </script>
                    <details style="margin-top: 1em">
                        <summary>@project.ShortDescription</summary>
                        <p>@project.LongDescription</p>
                    </details>
                    <footer style="padding: 1em; margin-top: 1em">
                        <p>
                            @string.Join(", ", project.Team.Select(m => m.FullName))
                            <br />
                            <a href="@project.Link" target="_blank">Homepage</a>
                        </p>
                    </footer>
                </article>
            }
        </section>
    }

    @* Shows projects matching the selected challenge (all, if none is selected), and sorts them and their awards so the selected challenge's come first (or the original order, if none is selected) *@
    <script>
        function indexOf(award) {
            return 1000 * parseInt(award.dataset.challengeOrder, 10) + parseInt(award.dataset.order, 10);
        }
        function orderOf(project, challenge) {
            const awardsContainer = project.querySelector("header");
            const awards = Array.from(awardsContainer.querySelectorAll("mark"));
            if (challenge === "") {
                return Math.min(Number.MAX_VALUE, ...awards.map(indexOf));
            }
            return Math.min(Number.MAX_VALUE, ...awards.filter(a => a.dataset.challenge === challenge).map(a => parseInt(a.dataset.order, 10)));
        }
        function showProjects(challenge) {
            const projectsContainer = document.querySelector("#projects-container");
            const projects = Array.from(projectsContainer.children);
            projects.forEach(project => {
                const awardsContainer = project.querySelector("header");
                const awards = Array.from(awardsContainer.querySelectorAll("mark"));
                if (challenge === "") {
                    project.style.display = 'block';
                    awards.sort((a, b) => indexOf(a) - indexOf(b));
                } else if (project.dataset.challenges.split("@challengesSeparator").includes(challenge)) {
                    project.style.display = 'block';
                    awards.sort((a, b) => {
                        if (a.dataset.challenge === challenge) {
                            return -1;
                        }
                        if (b.dataset.challenge === challenge) {
                            return 1;
                        }
                        return indexOf(a) - indexOf(b);
                    });
                } else {
                    project.style.display = 'none';
                }
                awardsContainer.append(...awards);
            });
            projects.sort((p1, p2) => orderOf(p1, challenge) - orderOf(p2, challenge));
            projectsContainer.append(...projects);
        }
        showProjects("");
    </script>
</main>